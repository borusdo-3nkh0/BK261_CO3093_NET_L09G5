%% ============================================================
%% FILE: refs.bib
%% DESC: Bibliography entries template
%%
%% CONVENTION LANGID:
%%    langid = {vietnamese} % tiếng Việt hoặc song ngữ
%%    langid = {english}    % tiếng Anh thuần
%%
%% CONVENTION AUTHOR NAME:
%%    Vietnamese author : author = {{Họ và tên đầy đủ}}  (double braces)
%%    Foreign author    : author = {Last, First}          (single braces)
%%
%% CONVENTION EDITION:
%%    edition = {lxb. 2},   % Vietnamese — use string form
%%    edition = {2},        % English — biblatex formats as "2nd ed." automatically
%% ============================================================

%% --- Journal Article ---

@article{journal_key,
    langid   = {vietnamese},
    author   = {Last, First and Last2, First2},
    title    = {Article Title},
    journal  = {Journal Name},
    year     = {2024},
    volume   = {1},
    number   = {1},
    pages    = {1--10},
    doi      = {10.xxxx/xxxxxx},
}

%% --- Conference Paper ---

@inproceedings{paper_key,
    langid    = {vietnamese},
    author    = {Last, First and Last2, First2},
    title     = {Paper Title},
    booktitle = {Conference Name (ABBR)},
    year      = {2024},
    pages     = {1--8},
    doi       = {10.xxxx/xxxxxx},
}

%% --- Book ---

@book{book_key,
    langid    = {vietnamese},
    author    = {Last, First},
    title     = {Book Title},
    edition   = {lxb. 2},
    publisher = {Publisher Name},
    address   = {City},
    year      = {2024},
}

%% --- Book Chapter ---

@incollection{book_chapter_key,
    langid    = {vietnamese},
    author    = {Last, First},
    title     = {Chapter Title},
    booktitle = {Book Title},
    editor    = {Last, First},
    publisher = {Publisher Name},
    address   = {City},
    year      = {2024},
    pages     = {1--20},
}

%% --- Website ---

@online{website_key,
    langid   = {vietnamese},
    author   = {Last, First},           % omit if no author
    title    = {Page Title},
    year     = {2024},                  % omit if no year
    url      = {https://example.com/page},
    urldate  = {2024-01-01},            % format: YYYY-MM-DD
}

%% --- Technical Report ---

@techreport{report_key,
    langid      = {vietnamese},
    author      = {Last, First},
    title       = {Report Title},
    institution = {Institution Name},
    year        = {2024},
    number      = {TR-2024-01},
    url         = {https://example.com/report.pdf},
}

%% --- Thesis ---

@thesis{thesis_key,
    langid      = {vietnamese},
    author      = {Last, First},
    title       = {Thesis Title},
    type        = {phdthesis},          % phdthesis: doctoral / mathesis: master's
    institution = {University Name},
    year        = {2024},
}
