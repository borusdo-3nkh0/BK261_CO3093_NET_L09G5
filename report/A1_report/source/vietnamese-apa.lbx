\ProvidesFile{vietnamese-apa.lbx}[\abx@lbxid]
\InheritBibliographyExtras{english}

% ── Declare APA-specific strings ────────────────────────────
\NewBibliographyString{retrieved}
\NewBibliographyString{from}
\NewBibliographyString{available}
\NewBibliographyString{on}

\DeclareBibliographyStrings{%
  bibliography   = {{Tài liệu tham khảo}{Tài liệu tham khảo}},
  references     = {{Tài liệu tham khảo}{Tài liệu tham khảo}},
  shorthands     = {{Danh sách viết tắt}{Viết tắt}},
  editor         = {{biên tập}{bt\adddot}},
  editors        = {{biên tập}{bt\adddot}},
  translator     = {{dịch}{dịch}},
  and            = {{và}{và}},
  andothers      = {{và các cộng sự}{et~al\adddot}},
  in             = {{trong}{trong}},
  volume         = {{tập}{t\adddot}},
  page           = {{trang}{tr\adddot}},
  pages          = {{trang}{tr\adddot}},
  chapter        = {{chương}{ch\adddot}},
  edition        = {{lần xuất bản}{lxb\adddot}},
  urlseen        = {{truy cập ngày}{truy cập ngày}},
  nodate         = {{n.d.}{n.d.}},
  retrieved      = {{Truy xuất}{Truy xuất}},
  from           = {{từ}{từ}},
  available      = {{có tại}{có tại}},
  on             = {{vào}{vào}},
}

\DeclareBibliographyExtras{%
  \def\urldatecomma{\addcomma\addspace}%
  \protected\def\mkbibordinal#1{#1}%
  \protected\def\mkbibmonth#1{\ifcase#1
    \or tháng 1\or tháng 2\or tháng 3\or tháng 4%
    \or tháng 5\or tháng 6\or tháng 7\or tháng 8%
    \or tháng 9\or tháng 10\or tháng 11\or tháng 12%
  \fi}%
  \protected\def\mkbibdateapalong#1#2#3#4{%
    \iffieldundef{#1}{}%
      {\iffieldbibstring{#1}{\bibncpstring{\thefield{#1}}}{\thefield{#1}}}%
    \iffieldundef{#3}{}%
      {\iffieldundef{#1}{}{\addcomma\addspace}%
       \mkbibmonth{\thefield{#3}}}%
    \iffieldundef{#4}{}%
      {\iffieldundef{#3}{}{\addspace}%
       \stripzeros{\thefield{#4}}}%
  }%
  \protected\def\mkbibdateapalongextra#1#2#3#4{%
    \iffieldundef{#1}{}%
      {\iffieldbibstring{#1}{\bibncpstring{\thefield{#1}}}{\thefield{#1}}%
       \printfield{extradate}}%
    \iffieldundef{#3}{}%
      {\iffieldundef{#1}{}{\addcomma\addspace}%
       \mkbibmonth{\thefield{#3}}}%
    \iffieldundef{#4}{}%
      {\iffieldundef{#3}{}{\addspace}%
       \stripzeros{\thefield{#4}}}%
  }%
  \protected\def\mkbibdateapalongmdy#1#2#3#4{%
    \iffieldundef{#4}{}%
      {\stripzeros{\thefield{#4}}/}%
    \iffieldundef{#3}{}%
      {\stripzeros{\thefield{#3}}/}%
    \iffieldundef{#1}{}%
      {\iffieldbibstring{#1}{\bibncpstring{\thefield{#1}}}{\thefield{#1}}}%
  }%
}

\endinput